{
    "name": "brewhaus-server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "node --watch src/dev.js",
        "start": "node src/dev.js",
        "vercel-build": "node src/db/prepare-account-deletion.js",
        "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.js",
        "db:push": "drizzle-kit push --config=src/db/drizzle.config.js",
        "db:studio": "drizzle-kit studio --config=src/db/drizzle.config.js",
        "db:seed": "node src/db/seed.js"
    },
    "dependencies": {
        "better-auth": "^1.7.15",
        "cors": "^2.8.6",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "postgres": "^4.0.0",
        "stripe": "^23.1.0"
    },
    "devDependencies": {
        "drizzle-kit": "^0.31.11"
    }
}
